      "name": "Finished",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "command": "=\"E:\\ffmpeg-9.0.1-essentials_build\\ffmpeg-9.0.1-essentials_build\\bin\\ffmpeg.exe\" -y -i \"{{$json.filePath}}\" -vn -ac 2 -ar 44100 -c:a pcm_s16le \"{{$json.outputPath}}\""
      },
      "id": "59cf9e6a-ddfe-4134-b80a-0c815afe71ac",
      "name": "Extract Audio",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        32,
        208
      ]
    },
    {
      "parameters": {
        "command": "=\"E:\\ffmpeg-9.0.1-essentials_build\\ffmpeg-9.0.1-essentials_build\\bin\\ffmpeg.exe\" -y -i \"{{$('Build Audio Path').item.json.outputPath}}\" -af \"afftdn=nf=-25,highpass=f=80,lowpass=f=12000,loudnorm=I=-16:TP=-1.5:LRA=11\" -c:a pcm_s16le \"{{$('Build Audio Path').item.json.outputPath.replace('_raw.wav','_enhanced.wav')}}\""
      },
      "id": "a9600a46-d965-4d85-b717-e614d0514175",
      "name": "Enhance Audio",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        208,
        208
      ]
    },
    {
      "parameters": {
        "command": "={{ 'E:\\\\ffmpeg-9.0.1-essentials_build\\\\ffmpeg-9.0.1-essentials_build\\\\bin\\\\ffmpeg.exe -y -i \"' + $('Build Audio Path').item.json.filePath + '\" -i \"' + $('Build Audio Path').item.json.outputPath.replace('_raw.wav','_enhanced.wav') + '\" -map 0:v:0 -map 1:a:0 -c:v copy -c:a aac -b:a 192k -shortest \"E:\\\\Audio Enhance\\\\output video\\\\' + $('Build Audio Path').item.json.fileName.replace(/\\.mp4$/i,'_enhanced.mp4') + '\"' }}"
      },
      "id": "d7b5db4f-01a1-40c3-b218-bef334a94e9a",
      "name": "Remux Video (replace audio)",
      "type": "n8n-nodes-base.executeCommand",
