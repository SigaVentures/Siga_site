      "name": "List Video Files",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        -800,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputDir = $('Config (EDIT THESE PATHS)').first().json.inputDir;\n\nconst output = $json.stdout\n  .trim()\n  .split(/\\r?\\n/)\n  .filter(name => name.trim() !== '')\n  .map(name => ({\n    fileName: name.trim(),\n    filePath: `${inputDir}\\\\${name.trim()}`\n  }));\n\nreturn output.map(item => ({ json: item }));"
      },
      "id": "03008249-0e7c-48f3-81af-78c0fac27776",
      "name": "Build File List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
