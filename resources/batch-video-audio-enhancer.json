      "position": [
        400,
        208
      ]
    },
    {
      "parameters": {
        "command": "=cmd /c del /f /q \"{{ $('Build Audio Path').item.json.outputPath }}\" \"{{ $('Build Audio Path').item.json.outputPath.replace('_raw.wav','_enhanced.wav') }}\""
      },
      "id": "39937ab5-2e33-48e7-8f1d-e2709e5d75b3",
